# ── Mika & Co. — Environment Variables ──────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit real secrets.

# ── Admin ────────────────────────────────────────────────────────
# Server-side passcode for the /admin dashboard (required — login fails closed)
ADMIN_PASSCODE=changeme

# ── Database (Neon Postgres) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Redis Cache & Rate Limiting (Upstash) ────────────────────────
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ── Email Notifications (Resend) ─────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"

# ── SMS Notifications (Greenweb BD / Twilio — optional) ──────────
GREENWEB_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Payment Gateways (sandbox configs — optional) ────────────────
PAYMENT_MODE=sandbox
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX=true
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_MERCHANT_NUMBER=""

# ── App URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://mikaandco.com"
